{
  "manifest_version": 3,
  "name": "Inno Extension",
  "version": "0.4.1",
  "description": "아마란스, Jira, Confluence의 사내 업무 편의 기능을 하나의 확장 프로그램으로 제공합니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Inno Extension",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://gw.innogrid.com/*"],
      "js": ["src/sites/amaranth/content.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pms-innogrid.atlassian.net/jira/*",
        "https://pms-innogrid.atlassian.net/browse/*",
        "https://pms-innogrid.atlassian.net/issues/*"
      ],
      "js": ["src/sites/jira/content.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://pms-innogrid.atlassian.net/wiki/*"],
      "js": ["src/sites/confluence/main.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://pms-innogrid.atlassian.net/wiki/*"],
      "js": ["src/sites/confluence/content.ts"],
      "run_at": "document_idle"
    }
  ]
}
